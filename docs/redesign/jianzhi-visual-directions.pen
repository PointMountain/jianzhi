            0
          ],
          "children": [
            {
              "type": "frame",
              "id": "Dt0yU",
              "name": "专注滚动视口",
              "clip": true,
              "width": "fill_container",
              "height": "fill_container",
              "layout": "vertical",
              "children": [
                {
                  "type": "frame",
                  "id": "EszTf",
                  "name": "专注完整章节",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "frame",
                      "id": "eGaN6",
                      "name": "阅读标记",
                      "width": "fill_container",
                      "gap": 10,
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "text",
                          "id": "bOik6",
                          "name": "说明",
                          "fill": "$a2-muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "第 3 节 · 工具调用",
                          "lineHeight": 1.5,
                          "fontFamily": "Noto Sans SC",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "WqEM7",
                          "name": "专注说明",
                          "fill": "$a2-muted",
                          "textGrowth": "fixed-width",
                          "width": 90,
                          "content": "专注阅读",
                          "lineHeight": 1.75,
                          "textAlign": "right",
                          "fontFamily": "Noto Sans SC",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "Mxi1e",
                      "name": "小标题",
                      "fill": "$a2-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "让语言，抵达真实世界",
                      "lineHeight": 1.5,
                      "fontFamily": "Noto Serif SC",
                      "fontSize": 30,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "Y4i8Ue",
                      "name": "专注导语",
                      "fill": "$a2-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "语言模型擅长理解和生成文本，但仅凭已有知识，无法知道今天的天气，也不能替你修改一份本地文件。工具调用把这些能力连接起来：模型决定需要什么信息，工具执行具体操作，再把结果交还给模型。",
                      "lineHeight": 1.75,
                      "fontFamily": "Noto Sans SC",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "oVPff",
                      "name": "小标题",
                      "fill": "$a2-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "1. 把“决定”与“执行”分开",
                      "lineHeight": 1.5,
                      "fontFamily": "Noto Serif SC",
                      "fontSize": 22,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "vFjIB",
                      "name": "专注解释",
                      "fill": "$a2-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "以查询天气为例，模型生成城市和日期等参数；天气工具查询数据；模型再基于返回结果组织回答。工具并不理解用户最终想做什么，它只按照约定的输入执行任务，把结果交回调用方。",
                      "lineHeight": 1.75,
                      "fontFamily": "Noto Sans SC",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "rURtq",
                      "name": "专注代码",
                      "width": "fill_container",
                      "fill": "$a2-soft",
                      "cornerRadius": 6,
                      "layout": "vertical",
                      "gap": 6,
                      "padding": 18,
                      "children": [
                        {
                          "type": "text",
                          "id": "W0anw",
                          "name": "说明",
                          "fill": "$a2-muted",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "请求与返回",
                          "lineHeight": 1.5,
                          "fontFamily": "Noto Sans SC",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "text",
                          "id": "MiIB6",
                          "name": "代码",
                          "fill": "$a2-ink",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "get_weather({ city: \"上海\", date: \"今天\" })\n// 工具返回\n{ temperature: 24, condition: \"多云\", rain_probability: 0.2 }",
                          "lineHeight": 1.7,
                          "fontFamily": "JetBrains Mono",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "GNwD3",
                      "name": "小标题",
                      "fill": "$a2-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "2. 工具结果仍然需要理解",
                      "lineHeight": 1.5,
                      "fontFamily": "Noto Serif SC",
                      "fontSize": 22,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "piHXN",
                      "name": "专注结果",
                      "fill": "$a2-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "工具返回的是数据，不一定是用户能直接使用的答案。模型还要检查结果是否完整，再结合问题解释温度、天气以及出行建议。用户问“今天适合散步吗”时，只返回 24℃ 还不够，还要考虑降雨概率、风力与用户的安排。",
                      "lineHeight": 1.75,
                      "fontFamily": "Noto Sans SC",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "g3W59",
                      "name": "专注循环",
                      "fill": "$a2-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "因此，工具调用往往是一个循环：先判断缺少什么信息，再选择工具和参数，拿到结果后重新判断。如果信息已经足够，就组织回答；如果仍然缺少关键条件，则继续查询或向用户追问。",
                      "lineHeight": 1.75,
                      "fontFamily": "Noto Sans SC",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "xx0aV",
                      "name": "小标题",
                      "fill": "$a2-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "3. 如果执行失败，会发生什么？",
                      "lineHeight": 1.5,
                      "fontFamily": "Noto Serif SC",
                      "fontSize": 22,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "tT1SF",
                      "name": "专注失败",
                      "fill": "$a2-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "当工具返回“没有找到这座城市”，模型不应该把失败当成天气数据。它可以核对城市名称、询问用户所在地区，或者明确说明这次查询没有成功。",
                      "lineHeight": 1.75,
                      "fontFamily": "Noto Sans SC",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "nWxeJ",
                      "name": "循环判断",
                      "fill": "$a2-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "这也是工具调用需要反复判断的原因。模型先观察已经拿到的结果，再决定是否继续查询、换一种工具，或结束本次请求。每一轮都应有明确的停止条件。",
                      "lineHeight": 1.75,
                      "fontFamily": "Noto Sans SC",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "hbfFz",
                      "name": "延续小标题",
                      "fill": "$a2-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "4. 从一次调用，到完整的工作流",
                      "lineHeight": 1.5,
                      "fontFamily": "Noto Serif SC",
                      "fontSize": 20,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "GtiVi",
                      "name": "完整流程",
                      "fill": "$a2-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "真实任务通常不止一个步骤。规划行程时，可能先查天气，再查路线与开放时间；读取代码时，可能先定位文件，再查看实现与测试。工具结果连接起来，才构成用户需要的完整答案。",
                      "lineHeight": 1.75,
                      "fontFamily": "Noto Sans SC",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "rPa7M",
                      "name": "边界约束",
                      "fill": "$a2-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "工具能做什么，取决于调用方实际提供的能力。只读查询、修改文件和发送消息具有不同后果，执行前需要检查参数、权限与当前任务的范围。",
                      "lineHeight": 1.75,
                      "fontFamily": "Noto Sans SC",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "q2P71",
                      "name": "延续小标题",
                      "fill": "$a2-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "小结：用一条链解释工具调用",
                      "lineHeight": 1.5,
                      "fontFamily": "Noto Serif SC",
                      "fontSize": 20,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "I7Oj8",
                      "name": "小结正文",
                      "fill": "$a2-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "用户提出目标 → 模型决定下一步 → 工具执行具体操作 → 结果回到上下文 → 模型继续判断。这条链帮助我们区分“会说什么”和“实际做了什么”。",
                      "lineHeight": 1.75,
                      "fontFamily": "Noto Sans SC",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        },
