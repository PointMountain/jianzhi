  "narrative": {
    "northStar": "阅读居中，导航退后，下一步清楚。",
    "overview": "A2「纸白」由用户于 2026-10-04 选定。纸白背景承接白色内容区，墨灰用于文字和主要操作，浅茶色表示当前选择。短标题保留宋体的阅读气质，长正文与控件采用清楚的中文无衬线字体。\n\n本文从已绘制的 Pen 变量、组件与全站稿提取，作为后续实现依据；不表示应用代码已经采用这些值。交互与页面覆盖见 [全站设计说明](docs/redesign/full-site.md)，索引见 [manifest.json](docs/redesign/manifest.json)。示例主题、日期、回答和数据仅用于评审。",
    "keyCharacteristics": [
      "92px 浅色全局导航，图标下保留可见文字。",
      "当前学习内容与主要行动优先，辅助信息按需展开。",
      "宋体短标题、无衬线正文、低饱和中性色。",
      "颜色与明确文案共同表达状态。"
    ],
    "rules": [
      "添加主题与设置放在侧栏底部的低频操作组。",
      "学习页采用紧凑边距与长章节滚动视口，优先提高正文与当前任务的可见空间。",
      "专注阅读收起导航和导师，退出恢复原模式、位置与草稿。",
      "主动回忆默认隐藏材料，查看后按提示辅助处理。"
    ],
    "dos": [
      "保持全站的组件、状态词和操作位置一致。",
      "保留当前小节的学习模式、草稿、位置和任务连续性。",
      "把“学完本节”与主动回忆结果分别显示。",
      "在学习主区域直接呈现当前任务与下一步。"
    ],
    "donts": [
      "不恢复大面积深色侧栏或醒目的侧栏宣传区。",
      "不把 AI 示例主题与示例记录写进新安装的数据。",
      "不用颜色、进度条或一次完成动作替代掌握证据。",
      "不把 JSON 导出称为包含材料与练习的完整备份。"
    ]
  }
}
